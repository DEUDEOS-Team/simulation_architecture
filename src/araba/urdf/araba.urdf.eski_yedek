  <!-- ================================================================ -->
  <!-- GAZEBO PLUGINS                                                     -->
  <!-- ================================================================ -->

  <!-- Ackermann sürüş kontrolü — /cmd_vel dinler, /odom yayınlar -->
  <gazebo>
    <plugin filename="gz-sim-ackermann-steering-system"
            name="gz::sim::systems::AckermannSteering">
      <left_joint>on_sol_tekerlek_donus</left_joint>
      <right_joint>on_sag_tekerlek_donus</right_joint>
      <left_steering_joint>on_sol_tekerlek_direksiyon</left_steering_joint>
      <right_steering_joint>on_sag_tekerlek_direksiyon</right_steering_joint>
      <rear_left_joint>arka_sol_tekerlek_donus</rear_left_joint>
      <rear_right_joint>arka_sag_tekerlek_donus</rear_right_joint>
      <kingpin_width>1.622</kingpin_width>
      <steering_limit>0.5</steering_limit>
      <wheel_base>1.675</wheel_base>
      <wheel_separation>1.622</wheel_separation>
      <wheel_radius>0.22</wheel_radius>
      <min_velocity>-2.78</min_velocity>
      <max_velocity>5.56</max_velocity>
      <min_acceleration>-5</min_acceleration>
      <max_acceleration>5</max_acceleration>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>
  </gazebo>

  <!-- Joint state yayıncısı — bridge /model/araba/joint_state -> /joint_states -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/model/araba/joint_state</topic>
    </plugin>
  </gazebo>

  <!-- ================================================================ -->
  <!-- TEKERLEK SÜRTÜNME PARAMETRELERİ                                   -->
  <!-- ================================================================ -->

  <gazebo reference="on_sol_tekerlek_donus_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1e6</kp>
    <kd>100</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>

  <gazebo reference="on_sag_tekerlek_donus_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1e6</kp>
    <kd>100</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>

  <gazebo reference="arka_sol_tekerlek_donus_link">
