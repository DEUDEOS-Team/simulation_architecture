<?xml version="1.0" ?>
<!--
  saha_dunyasi.sdf — GERÇEK yarışma sahası dünyası.

  Zemin dokusu (saha_zemin.png) missions/map_islenmis.geojson'daki yol ağından
  scripts/tools/generate_saha_ground.py ile üretilir; saha_kutu'nun pose/size
  değerleri o script'in çıktısıyla SENKRON tutulmalıdır. Datum benim_dunyam.sdf
  ile aynıdır (launch DATUM_* ve final_odom ile senkron); böylece mission
  planning'in kullandığı saha GeoJSON koordinatları bu dünyada birebir yerine
  oturur. Başlatma:

    ros2 launch araba gazebo.launch.py world:=saha_dunyasi.sdf \
      mission_file:=<pkg>/missions/saha_deneme_gorev.geojson \
      centerlines_file:=<pkg>/missions/map_islenmis.geojson \
      spawn_x:=-38.53 spawn_y:=-0.91 spawn_yaw:=-0.85

  Trafik ışığı/levha/tünel modelleri henüz yok — konumları arkadaştan gelince
  eklenecek (tünel yeri belli: map_islenmis'te tunnel:true kenarlar).
-->
<sdf version="1.10">
  <world name="saha_dunyasi">
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system"/>
    <plugin name="gz::sim::systems::NavSat" filename="gz-sim-navsat-system"/>

    <!-- GPS datumu: benim_dunyam.sdf / launch DATUM_* / final_odom ile senkron -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>40.7899</latitude_deg>
      <longitude_deg>29.5089</longitude_deg>
      <elevation>30.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>5.5645e-06 2.28758e-05 -4.23884e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.3 0.6 0.9 1</background>
      <shadows>false</shadows>
    </scene>

    <!-- Geniş yeşil taban (saha kutusunun dışı) -->
    <model name="zemin">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>1000 1000</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>1000 1000</size></plane></geometry>
          <material>
            <ambient>0.06 0.2 0.08 1</ambient>
            <diffuse>0.07 0.24 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Saha zemini: generate_saha_ground.py çıktısıyla senkron pose/size -->
    <model name="saha_kutu">
      <static>true</static>
      <pose>0.354 4.141 0.01 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>103.868 113.687 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>103.868 113.687 0.1</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <pbr><metal><albedo_map>saha_zemin.png</albedo_map></metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Çevre duvarları: dönüşlerde ufuktaki gökyüzünü kapatır (benim_dunyam ile aynı amaç) -->
    <model name="cevre_duvar_kuzey">
      <static>true</static>
      <pose>0.354 81 12.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>170 3 25</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>170 3 25</size></box></geometry>
          <material><ambient>0.1 0.4 0.15 1</ambient><diffuse>0.12 0.45 0.18 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="cevre_duvar_guney">
      <static>true</static>
      <pose>0.354 -73 12.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>170 3 25</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>170 3 25</size></box></geometry>
          <material><ambient>0.1 0.4 0.15 1</ambient><diffuse>0.12 0.45 0.18 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="cevre_duvar_dogu">
      <static>true</static>
      <pose>68 4.141 12.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3 160 25</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>3 160 25</size></box></geometry>
          <material><ambient>0.1 0.4 0.15 1</ambient><diffuse>0.12 0.45 0.18 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="cevre_duvar_bati">
      <static>true</static>
      <pose>-68 4.141 12.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3 160 25</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>3 160 25</size></box></geometry>
          <material><ambient>0.1 0.4 0.15 1</ambient><diffuse>0.12 0.45 0.18 1</diffuse></material>
        </visual>
      </link>
    </model>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>
  </world>
</sdf>
