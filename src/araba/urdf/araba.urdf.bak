  <!-- ================================================================ -->
  <!-- GAZEBO PLUGINS                                                     -->
  <!-- ================================================================ -->

  <!-- Ackermann surus kontrolu — /cmd_vel dinler, /odom yayinlar -->
  <gazebo>
    <plugin filename="gz-sim-ackermann-steering-system"
            name="gz::sim::systems::AckermannSteering">
      <left_joint>on_sol_ileri_donus_hareket</left_joint>
      <right_joint>on_sag_ileri_donus_hareket</right_joint>
      <left_steering_joint>on_sol_yatay_direksiyon_hareket</left_steering_joint>
      <right_steering_joint>on_sag_yatay_direksiyon_hareket</right_steering_joint>
      <rear_left_joint>arka_sol_ileri_donus_hareket</rear_left_joint>
      <rear_right_joint>arka_sag_ileri_donus_hareket</rear_right_joint>
      <kingpin_width>1.486</kingpin_width>
      <steering_limit>0.5236</steering_limit>
      <wheel_base>1.675</wheel_base>
      <wheel_separation>1.486</wheel_separation>
      <wheel_radius>0.22</wheel_radius>
      <min_velocity>-2.78</min_velocity>
      <max_velocity>5.56</max_velocity>
      <min_acceleration>-5</min_acceleration>
      <max_acceleration>5</max_acceleration>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>
  </gazebo>

  <!-- Joint state yayincisi — bridge /model/araba/joint_state -> /joint_states -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/model/araba/joint_state</topic>
    </plugin>
  </gazebo>

  <!-- ================================================================ -->
  <!-- TEKERLEK SURTUNME PARAMETRELERI                                   -->
  <!-- ================================================================ -->

  <gazebo reference="on_sol_ileri_donus_hareket_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1e6</kp>
    <kd>100</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>

  <gazebo reference="on_sag_ileri_donus_hareket_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1e6</kp>
    <kd>100</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>

  <gazebo reference="arka_sol_ileri_donus_hareket_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1e6</kp>
    <kd>100</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>

  <gazebo reference="arka_sag_ileri_donus_hareket_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1e6</kp>
    <kd>100</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>

  <!-- ================================================================ -->
  <!-- SENSORLER                                                          -->
  <!-- ================================================================ -->

  <!-- SICK multiScan100 — 16 katman, 360°, 0.17° cozunurluk, 100m, 20Hz -->
  <gazebo reference="lidar_sensor_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>/lidar/scan</topic>
      <update_rate>20</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>2118</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>-0.261799</min_angle>
            <max_angle>0.261799</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.1</min>
          <max>100.0</max>
          <resolution>0.004</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0</mean>
          <stddev>0.02</stddev>
        </noise>
      </lidar>
      <gz_frame_id>lidar_sensor_link</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- Intel RealSense D415 — 1280x720, 69.4° FOV, 30 Hz; /camera/image yayinlar -->
  <gazebo reference="cam_sensor_link">
    <sensor name="camera" type="camera">
      <topic>/camera/image</topic>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.2113</horizontal_fov>
        <image>
          <width>1280</width>
          <height>720</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <gz_frame_id>cam_sensor_link</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- IMU — 100 Hz; /imu/data yayinlar -->
  <gazebo reference="imu_sensor_link">
    <sensor name="imu" type="imu">
      <topic>/imu/data</topic>
      <update_rate>100</update_rate>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <gz_frame_id>imu_sensor_link</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- GPS (NavSat) — 10 Hz; /gps/fix yayinlar -->
  <gazebo reference="gps_sensor_link">
    <sensor name="gps" type="navsat">
      <topic>/gps/fix</topic>
      <update_rate>10</update_rate>
      <gz_frame_id>gps_sensor_link</gz_frame_id>
    </sensor>
  </gazebo>

</robot>
