<?xml version="1.0" ?>
<sdf version="1.10">
  <model name="park_yeri">
    
    <!-- Çarpıp devrilmemesi veya yere düşmemesi için sabitliyoruz -->
    <static>true</static> 
    
    <link name="link">
      
      <!-- ================= DİREK KISMI ================= -->
      <!-- Direğin Fiziksel Çarpışma Alanı -->
      <collision name="direk_collision">
        <pose>0 0 1.0 0 0 0</pose> <!-- Yerden 1 metre yukarıda merkezi var -->
        <geometry>
          <cylinder>
            <radius>0.05</radius> <!-- 5 cm yarıçap -->
            <length>1.8</length>  <!-- 2 metre uzunluk -->
          </cylinder>
        </geometry>
      </collision>

      <!-- Direğin Görseli -->
      <visual name="direk_visual">
        <pose>0 0 1.0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>1.8</length>
          </cylinder>
        </geometry>
        <material>
          <!-- Direk için basit gri renk -->
          <ambient>0.5 0.5 0.5 1</ambient> 
          <diffuse>0.5 0.5 0.5 1</diffuse>
        </material>
      </visual>

      <!-- ================= TABELA KISMI ================= -->
      <!-- Tabelanın Fiziksel Çarpışma Alanı -->
      <collision name="tabela_collision">
        <pose>0 0 2.2 0 0 0</pose> <!-- Direğin tepesinde (2.2 metre yüksekte) -->
        <geometry>
          <box>
            <size>0.05 0.8 0.8</size> <!-- Kalınlık: 5cm, Genişlik: 80cm, Boy: 80cm -->
          </box>
        </geometry>
      </collision>

      <!-- Tabelanın Arka Paneli — arka yüzde PNG görünüp algıyı şaşırtmasın diye gri kapak -->
      <visual name="tabela_arka_visual">
        <pose>-0.03 0 2.2 0 0 0</pose>
        <geometry>
          <box>
            <size>0.04 0.8 0.8</size>
          </box>
        </geometry>
        <material>
          <ambient>0.4 0.4 0.4 1</ambient>
          <diffuse>0.4 0.4 0.4 1</diffuse>
        </material>
      </visual>

      <!-- Tabelanın Görseli (İşte PNG Buraya Geliyor) -->
      <visual name="tabela_visual">
        <pose>0 0 2.2 0 0 0</pose>
        <geometry>
          <box>
            <size>0.05 0.8 0.8</size>
          </box>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <!-- DİKKAT: Buradaki yolu kendi klasör adına ve resmine göre düzenle -->
              <albedo_map>model://park_yeri/materials/park_yeri.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>

    </link>
  </model>
</sdf>